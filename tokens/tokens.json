{
  "$description": "NN Design System tokens in the W3C Design Tokens Community Group (DTCG) format. This file is the source of truth; `npm run build:tokens` resolves it into dist/tokens.json (this file), dist/tokens.js (resolved light/dark maps) and verifies src/styles/tokens.css has not drifted. Dark-theme overrides live in each token's $extensions['nn.mode.dark'].",
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f8fafc" },
      "100": { "$value": "#f1f5f9" },
      "200": { "$value": "#e2e8f0" },
      "300": { "$value": "#cbd5e1" },
      "400": { "$value": "#94a3b8" },
      "500": { "$value": "#64748b" },
      "600": { "$value": "#475569" },
      "700": { "$value": "#334155" },
      "800": { "$value": "#1e293b" },
      "900": { "$value": "#0f172a" },
      "950": { "$value": "#020617" }
    },
    "indigo": {
      "50": { "$value": "#eef2ff" },
      "100": { "$value": "#e0e7ff" },
      "200": { "$value": "#c7d2fe" },
      "300": { "$value": "#a5b4fc" },
      "400": { "$value": "#818cf8" },
      "500": { "$value": "#6366f1" },
      "600": { "$value": "#4f46e5" },
      "700": { "$value": "#4338ca" },
      "800": { "$value": "#3730a3" },
      "900": { "$value": "#312e81" },
      "950": { "$value": "#1e1b4b" }
    },
    "emerald": {
      "50": { "$value": "#ecfdf5" },
      "500": { "$value": "#10b981" },
      "600": { "$value": "#059669" },
      "700": { "$value": "#047857" },
      "950": { "$value": "#022c22" }
    },
    "amber": {
      "50": { "$value": "#fffbeb" },
      "500": { "$value": "#f59e0b" },
      "600": { "$value": "#d97706" },
      "700": { "$value": "#b45309" },
      "950": { "$value": "#451a03" }
    },
    "red": {
      "50": { "$value": "#fef2f2" },
      "500": { "$value": "#ef4444" },
      "600": { "$value": "#dc2626" },
      "700": { "$value": "#b91c1c" },
      "950": { "$value": "#450a0a" }
    },
    "sky": {
      "50": { "$value": "#f0f9ff" },
      "500": { "$value": "#0ea5e9" },
      "600": { "$value": "#0284c7" },
      "700": { "$value": "#0369a1" },
      "950": { "$value": "#082f49" }
    }
  },
  "semanticColor": {
    "$type": "color",
    "$description": "Emitted as --nn-color-*. Only these change between themes.",
    "surface-1": {
      "$value": "{color.neutral.0}",
      "$extensions": { "nn.mode.dark": "{color.neutral.900}" }
    },
    "surface-2": {
      "$value": "{color.neutral.50}",
      "$extensions": { "nn.mode.dark": "{color.neutral.800}" }
    },
    "surface-3": {
      "$value": "{color.neutral.100}",
      "$extensions": { "nn.mode.dark": "{color.neutral.700}" }
    },
    "border": {
      "$value": "{color.neutral.200}",
      "$extensions": { "nn.mode.dark": "{color.neutral.700}" }
    },
    "border-strong": {
      "$value": "{color.neutral.300}",
      "$extensions": { "nn.mode.dark": "{color.neutral.600}" }
    },
    "overlay": {
      "$value": "rgb(2 6 23 / 0.55)",
      "$extensions": { "nn.mode.dark": "rgb(2 6 23 / 0.7)" }
    },
    "text": {
      "$value": "{color.neutral.900}",
      "$extensions": { "nn.mode.dark": "{color.neutral.50}" }
    },
    "text-muted": {
      "$value": "{color.neutral.600}",
      "$extensions": { "nn.mode.dark": "{color.neutral.300}" }
    },
    "text-subtle": {
      "$value": "{color.neutral.500}",
      "$extensions": { "nn.mode.dark": "{color.neutral.400}" }
    },
    "text-inverted": {
      "$value": "{color.neutral.0}",
      "$extensions": { "nn.mode.dark": "{color.neutral.900}" }
    },
    "primary": {
      "$value": "{color.indigo.600}",
      "$extensions": { "nn.mode.dark": "{color.indigo.500}" }
    },
    "primary-hover": {
      "$value": "{color.indigo.700}",
      "$extensions": { "nn.mode.dark": "{color.indigo.600}" }
    },
    "primary-active": {
      "$value": "{color.indigo.800}",
      "$extensions": { "nn.mode.dark": "{color.indigo.700}" }
    },
    "primary-fg": {
      "$value": "{color.neutral.0}",
      "$extensions": { "nn.mode.dark": "{color.neutral.0}" }
    },
    "primary-subtle": {
      "$value": "{color.indigo.50}",
      "$extensions": { "nn.mode.dark": "{color.indigo.950}" }
    },
    "primary-subtle-fg": {
      "$value": "{color.indigo.800}",
      "$extensions": { "nn.mode.dark": "{color.indigo.200}" }
    },
    "success": { "$value": "{color.emerald.600}" },
    "success-fg": { "$value": "{color.neutral.0}" },
    "success-subtle": {
      "$value": "{color.emerald.50}",
      "$extensions": { "nn.mode.dark": "{color.emerald.950}" }
    },
    "success-subtle-fg": {
      "$value": "{color.emerald.700}",
      "$extensions": { "nn.mode.dark": "#6ee7b7" }
    },
    "warning": { "$value": "{color.amber.500}" },
    "warning-fg": { "$value": "{color.neutral.900}" },
    "warning-subtle": {
      "$value": "{color.amber.50}",
      "$extensions": { "nn.mode.dark": "{color.amber.950}" }
    },
    "warning-subtle-fg": {
      "$value": "{color.amber.700}",
      "$extensions": { "nn.mode.dark": "#fcd34d" }
    },
    "danger": { "$value": "{color.red.600}" },
    "danger-fg": { "$value": "{color.neutral.0}" },
    "danger-subtle": {
      "$value": "{color.red.50}",
      "$extensions": { "nn.mode.dark": "{color.red.950}" }
    },
    "danger-subtle-fg": {
      "$value": "{color.red.700}",
      "$extensions": { "nn.mode.dark": "#fca5a5" }
    },
    "info": { "$value": "{color.sky.600}" },
    "info-fg": { "$value": "{color.neutral.0}" },
    "info-subtle": {
      "$value": "{color.sky.50}",
      "$extensions": { "nn.mode.dark": "{color.sky.950}" }
    },
    "info-subtle-fg": { "$value": "{color.sky.700}", "$extensions": { "nn.mode.dark": "#7dd3fc" } },
    "focus": { "$value": "{color.indigo.500}" }
  },
  "focusRing": {
    "$type": "shadow",
    "$description": "Emitted as --nn-focus-ring.",
    "default": { "$value": "0 0 0 3px rgb(99 102 241 / 0.35)" }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale — gaps, padding, margins. Emitted as --nn-space-*.",
    "0": { "$value": "0rem" },
    "3xs": { "$value": "0.125rem" },
    "2xs": { "$value": "0.25rem" },
    "xs": { "$value": "0.5rem" },
    "sm": { "$value": "0.75rem" },
    "md": { "$value": "1rem" },
    "lg": { "$value": "1.5rem" },
    "xl": { "$value": "2rem" },
    "2xl": { "$value": "3rem" },
    "3xl": { "$value": "4rem" }
  },
  "width": {
    "$type": "dimension",
    "$description": "Content widths — feed max-width, not gaps. Emitted as --nn-width-*.",
    "prose": { "$value": "65ch" },
    "sm": { "$value": "40rem" },
    "md": { "$value": "56rem" },
    "lg": { "$value": "72rem" },
    "xl": { "$value": "90rem" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Emitted as --nn-radius-*.",
    "xs": { "$value": "0.25rem" },
    "sm": { "$value": "0.375rem" },
    "md": { "$value": "0.5rem" },
    "lg": { "$value": "0.75rem" },
    "xl": { "$value": "1rem" },
    "2xl": { "$value": "1.5rem" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    },
    "mono": {
      "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
    }
  },
  "text": {
    "$description": "Type ramp. Each step emits --nn-text-<key> (size) and --nn-text-<key>--line-height.",
    "caption": {
      "size": { "$type": "dimension", "$value": "0.75rem" },
      "lineHeight": { "$type": "dimension", "$value": "1rem" }
    },
    "sm": {
      "size": { "$type": "dimension", "$value": "0.875rem" },
      "lineHeight": { "$type": "dimension", "$value": "1.25rem" }
    },
    "body": {
      "size": { "$type": "dimension", "$value": "1rem" },
      "lineHeight": { "$type": "dimension", "$value": "1.5rem" }
    },
    "body-lg": {
      "size": { "$type": "dimension", "$value": "1.125rem" },
      "lineHeight": { "$type": "dimension", "$value": "1.75rem" }
    },
    "h4": {
      "size": { "$type": "dimension", "$value": "1.25rem" },
      "lineHeight": { "$type": "dimension", "$value": "1.75rem" }
    },
    "h3": {
      "size": { "$type": "dimension", "$value": "1.5rem" },
      "lineHeight": { "$type": "dimension", "$value": "2rem" }
    },
    "h2": {
      "size": { "$type": "dimension", "$value": "1.875rem" },
      "lineHeight": { "$type": "dimension", "$value": "2.25rem" }
    },
    "h1": {
      "size": { "$type": "dimension", "$value": "2.25rem" },
      "lineHeight": { "$type": "dimension", "$value": "2.5rem" }
    },
    "display": {
      "size": { "$type": "dimension", "$value": "3rem" },
      "lineHeight": { "$type": "number", "$value": "1.1" }
    }
  },
  "weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Emitted as --nn-shadow-*. Dark uses opaque-black variants.",
    "sm": {
      "$value": "0 1px 2px rgb(2 6 23 / 0.06), 0 1px 1px rgb(2 6 23 / 0.04)",
      "$extensions": { "nn.mode.dark": "0 1px 2px rgb(0 0 0 / 0.4)" }
    },
    "md": {
      "$value": "0 4px 12px rgb(2 6 23 / 0.08)",
      "$extensions": { "nn.mode.dark": "0 4px 12px rgb(0 0 0 / 0.45)" }
    },
    "lg": {
      "$value": "0 12px 32px rgb(2 6 23 / 0.12)",
      "$extensions": { "nn.mode.dark": "0 12px 32px rgb(0 0 0 / 0.55)" }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "180ms" }
  },
  "ease": {
    "$type": "cubicBezier",
    "default": { "$value": "cubic-bezier(0.2, 0, 0.13, 1)" }
  },
  "z": {
    "$type": "number",
    "$description": "Emitted as --nn-z-*.",
    "dropdown": { "$value": 1000 },
    "sticky": { "$value": 1100 },
    "overlay": { "$value": 1200 },
    "modal": { "$value": 1300 },
    "tooltip": { "$value": 1400 }
  }
}

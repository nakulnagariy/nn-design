{
  "name": "nn-design",
  "version": "0.1.0",
  "description": "NN Design System — React components, design tokens, page blocks, and a Tailwind v4 preset.",
  "license": "MIT",
  "author": "Nakul Nagariya",
  "type": "module",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "design-tokens",
    "tailwind",
    "tailwindcss",
    "typescript",
    "accessible"
  ],
  "homepage": "https://nakulnagariy.github.io/nn-design/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakulnagariy/nn-design.git"
  },
  "bugs": {
    "url": "https://github.com/nakulnagariy/nn-design/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:js": "vite build",
    "build:css": "postcss src/styles/index.css -o dist/styles.css && postcss src/styles/tokens.css -o dist/tokens.css",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/react-vite": "^9.1.3",
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9.1.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  }
}

{
  "name": "nn-design",
  "version": "0.2.0",
  "description": "NN Design System — React components, design tokens, page blocks, and a Tailwind v4 preset.",
  "license": "MIT",
  "author": "Nakul Nagariya",
  "type": "module",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "design-tokens",
    "tailwind",
    "tailwindcss",
    "typescript",
    "accessible"
  ],
  "homepage": "https://nakulnagariy.github.io/nn-design/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakulnagariy/nn-design.git"
  },
  "bugs": {
    "url": "https://github.com/nakulnagariy/nn-design/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:js": "vite build",
    "build:css": "postcss src/styles/index.css -o dist/styles.css && postcss src/styles/tokens.css -o dist/tokens.css",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build": "npm run clean && npm run build:js && npm run build:css && npm run build:tokens",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css tokens.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build && npm run lint:package"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@microsoft/api-extractor": "^7.59.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/react-vite": "^9.1.3",
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^9.1.20",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9.1.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
